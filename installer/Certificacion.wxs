<?xml version="1.0" encoding="UTF-8"?>
<!--
  Certificacion.wxs : Instalador MSI (WiX Toolset v5)

  IMPORTANTE: este archivo se compila DESDE la carpeta installer/.
  Todas las rutas de origen son relativas a esta carpeta:
      ..\dist\Certificacion\**   -> salida de PyInstaller
      preparar_datos.ps1         -> vecino de este archivo
      licencia.rtf               -> vecino de este archivo

  Los comandos de compilacion estan en CHANGELOG.txt (los guiones dobles
  de las opciones de linea de comandos no son validos en comentarios XML).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef VersionApp ?>
    <?define VersionApp = "1.0.0" ?>
  <?endif?>

  <?define NombreApp = "Certificacion" ?>
  <?define NombreVisible = "Certificación" ?>
  <?define Ejecutable = "Certificacion.exe" ?>

  <Package
      Name="$(NombreVisible)"
      Manufacturer="Pacífico Seguros"
      Version="$(VersionApp)"
      UpgradeCode="8F3C1A72-5D94-4B60-9E2A-7C4B1F0D6E35"
      Scope="perUser"
      Compressed="yes">

    <SummaryInformation
        Description="$(NombreVisible) $(VersionApp)"
        Manufacturer="Pacífico Seguros" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Ya hay una versión más reciente de $(NombreVisible) instalada." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="IconoApp" SourceFile="..\app\ui\assets\logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="IconoApp" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- ==================================================================
         CARPETA DE DATOS
         Sobrescribible: msiexec /i ... DATA_PATH="D:\ruta"
         ================================================================== -->
    <Property Id="DATA_PATH" Secure="yes" />

    <SetProperty Id="DATA_PATH"
                 Value="[PersonalFolder]Certificacion\Datos"
                 Before="CostFinalize"
                 Sequence="both"
                 Condition="NOT DATA_PATH" />

    <!-- Cierre de la app en curso. Sustituye al bloque Pascal con
         OpenProcess / WaitForSingleObject del setup.iss. -->
    <util:CloseApplication
        Id="CerrarCertificacion"
        Target="$(Ejecutable)"
        CloseMessage="yes"
        RebootPrompt="no"
        PromptToContinue="yes"
        Description="Cierra $(NombreVisible) para continuar con la instalación." />

    <!-- ==================================================================
         DIRECTORIOS
         ================================================================== -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CarpetaProgramas" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(NombreApp)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CarpetaMenu" Name="$(NombreVisible)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ==================================================================
         FEATURES
         ================================================================== -->
    <Feature Id="Principal" Title="$(NombreVisible)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ArchivosApp" />
      <ComponentGroupRef Id="AccesosDirectos" />
      <ComponentGroupRef Id="Registro" />
    </Feature>

    <Feature Id="AccesoEscritorio" Title="Acceso directo en el escritorio" Level="1">
      <ComponentGroupRef Id="AccesoEscritorioCG" />
    </Feature>

    <!-- ==================================================================
         INTERFAZ
         ================================================================== -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="licencia.rtf" />

    <!-- ==================================================================
         ACCION PERSONALIZADA: estructura de datos + .env

         Tipo 34 (Directory + ExeCommand), Execute="immediate".

         RAZON de immediate y no deferred: la instalacion es per-user y
         escribe en %LOCALAPPDATA% y Documentos, asi que no necesita
         elevacion ni el mecanismo de CustomActionData. Ademas una CA
         deferred NO resuelve properties como [DATA_PATH] dentro de
         ExeCommand, que era un fallo latente de la version anterior.

         RAZON de no usar WixQuietExec: evita depender del nombre interno
         de la binary del UtilExtension, que cambia entre versiones de WiX.
         ================================================================== -->
    <CustomAction Id="PrepararDatos"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]preparar_datos.ps1&quot; -DataPath &quot;[DATA_PATH]&quot; -InstallDir &quot;[INSTALLFOLDER]&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="PrepararDatos"
              After="InstallFiles"
              Condition="NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>

  <!-- ====================================================================
       ARCHIVOS
       <Files Include="**"> cosecha todo el onedir de PyInstaller en tiempo
       de compilacion: evita declarar a mano los cientos de DLLs de
       PySide6 / pandas o depender de heat.exe.
       ==================================================================== -->
  <Fragment>
    <ComponentGroup Id="ArchivosApp" Directory="INSTALLFOLDER">
      <Files Include="..\dist\Certificacion\**" />

      <!-- El script de la CA se instala junto a la app, no en %TEMP%:
           AppLocker en el Cloud PC bloquea scripts desde rutas temporales. -->
      <Component Id="ScriptPrepararDatos">
        <File Id="preparar_datos.ps1"
              Source="preparar_datos.ps1"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ====================================================================
       ACCESOS DIRECTOS
       En per-user cada componente necesita KeyPath en HKCU; por eso cada
       shortcut lleva su RegistryValue asociado.
       ==================================================================== -->
  <Fragment>
    <ComponentGroup Id="AccesosDirectos">
      <Component Id="AccesoMenuInicio" Directory="CarpetaMenu">
        <Shortcut Id="ShortcutMenu"
                  Name="Certificación"
                  Target="[INSTALLFOLDER]Certificacion.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="IconoApp" />
        <RemoveFolder Id="LimpiarCarpetaMenu" Directory="CarpetaMenu" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Pacifico\Certificacion"
                       Name="AccesoMenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AccesoEscritorioCG">
      <Component Id="AccesoEscritorio" Directory="DesktopFolder">
        <Shortcut Id="ShortcutEscritorio"
                  Name="Certificación"
                  Target="[INSTALLFOLDER]Certificacion.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="IconoApp" />
        <RegistryValue Root="HKCU"
                       Key="Software\Pacifico\Certificacion"
                       Name="AccesoEscritorio"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ====================================================================
       REGISTRO Y LIMPIEZA
       ==================================================================== -->
  <Fragment>
    <ComponentGroup Id="Registro">
      <Component Id="RegistroConfig" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKCU" Key="Software\Pacifico\Certificacion">
          <RegistryValue Name="DataPath" Type="string" Value="[DATA_PATH]" KeyPath="yes" />
          <RegistryValue Name="Version"  Type="string" Value="$(VersionApp)" />
        </RegistryKey>
      </Component>

      <!-- El .env lo crea la CA, no MSI, asi que hay que declarar su
           borrado explicitamente (equivale al [UninstallDelete] de Inno). -->
      <Component Id="LimpiarEnv" Directory="INSTALLFOLDER">
        <RemoveFile Id="BorrarEnv" Name=".env" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Pacifico\Certificacion"
                       Name="LimpiezaEnv"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
